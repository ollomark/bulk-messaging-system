# Discord Developer Portal > Application > Bot
DISCORD_TOKEN=bot_token_buraya
CLIENT_ID=uygulama_client_id
# Tek sunucu için hızlı komut kaydı (opsiyonel ama önerilir)
GUILD_ID=sunucu_id

# Bot sahibi Discord kullanıcı ID (gelişmiş komutlar)
OWNER_ID=sizin_discord_id
# /anonim komutu sadece OWNER_ID kullanabilir

# Web kontrol paneli şifresi
PANEL_SECRET=guclu_bir_sifre
PANEL_PORT=3080

# Varsayılan renk (hex, # olmadan) — sky/gold suite
EMBED_COLOR=0EA5E9

# Hoş geldin mesajının kaç saniye sonra silineceği (0 = silme)
WELCOME_DELETE_AFTER=30

# 7/24 ses kanalı (opsiyonel — /ses katil ile de ayarlanır)
VOICE_CHANNEL_ID=

# Log kanalı (sürekli event logları buraya gider)
LOG_CHANNEL_ID=

# Seviye XP / bildirim kanalı (sohbet-i-muhabbet)
LEVEL_CHANNEL_ID=

# Custom status rolü (/sorgutr) — Presence Intent gerekir
STATUS_ROLE_ENABLED=0
STATUS_ROLE_GUILD_ID=
STATUS_ROLE_ID=
STATUS_ROLE_WARN_CHANNEL_ID=

# freeEgexzon duvar
FREE_EGEXZON_GUILD_ID=
FREE_EGEXZON_CHANNEL_ID=
