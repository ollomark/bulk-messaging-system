# Discord Developer Portal > Application > Bot
DISCORD_TOKEN=bot_token_buraya
CLIENT_ID=uygulama_client_id
# Tek sunucu için hızlı komut kaydı (opsiyonel ama önerilir)
GUILD_ID=sunucu_id

# Bot sahibi Discord kullanıcı ID (gelişmiş komutlar)
OWNER_ID=sizin_discord_id

# Varsayılan renk (hex, # olmadan)
EMBED_COLOR=5865F2

# Hoş geldin mesajının kaç saniye sonra silineceği (0 = silme)
WELCOME_DELETE_AFTER=30
